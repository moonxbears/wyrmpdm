<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="HackPDM.Status.StatusDialogView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="using:HackPDM.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:tv="using:WinUI.TableView"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
	mc:Ignorable="d">
	<Grid Margin="12" RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition x:Name="OperationsRow" Height="3*" />
			<RowDefinition Height="Auto" />
			<RowDefinition x:Name="LowerLogsRow" Height="2*" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border
			Grid.Row="0"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="6">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<Border Grid.Row="0" Padding="10,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
					<TextBlock FontSize="12" FontWeight="SemiBold" Text="Operations" />
				</Border>
				<tv:TableView
					Grid.Row="1"
					AutoGenerateColumns="False"
					BorderThickness="0"
					CanSortColumns="True"
					IsReadOnly="True"
					ItemsSource="{x:Bind ViewModel.OStatus, Mode=OneWay}"
					RowDetailsVisibilityMode="Collapsed">
					<tv:TableView.Columns>
						<tv:TableViewTextColumn Width="120" Binding="{Binding Status}" Header="Action" />
						<tv:TableViewTextColumn Width="*" Binding="{Binding Message}" Header="Description" />
					</tv:TableView.Columns>
				</tv:TableView>
			</Grid>
		</Border>

		<common:PaneSplitter Grid.Row="1" DragDelta="HorizontalSplitter_DragDelta" Orientation="Horizontal" />

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition x:Name="InfoLogCol" Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition x:Name="ErrorLogCol" Width="*" />
			</Grid.ColumnDefinitions>

			<Border
				Grid.Column="0"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="6">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Grid.Row="0" Padding="10,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
						<TextBlock FontSize="12" FontWeight="SemiBold" Text="Info" />
					</Border>
					<tv:TableView
						Grid.Row="1"
						AutoGenerateColumns="False"
						BorderThickness="0"
						CanSortColumns="True"
						IsReadOnly="True"
						ItemsSource="{x:Bind ViewModel.OInfo, Mode=OneWay}"
						RowDetailsVisibilityMode="Collapsed">
						<tv:TableView.Columns>
							<tv:TableViewTextColumn Width="120" Binding="{Binding Status}" Header="Action" />
							<tv:TableViewTextColumn Width="*" Binding="{Binding Message}" Header="Description" />
						</tv:TableView.Columns>
					</tv:TableView>
				</Grid>
			</Border>

			<common:PaneSplitter Grid.Column="1" DragDelta="VerticalSplitter_DragDelta" Orientation="Vertical" />

			<Border
				Grid.Column="2"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="6">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Grid.Row="0" Padding="10,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
						<TextBlock FontSize="12" FontWeight="SemiBold" Text="Warnings &amp; Errors" />
					</Border>
					<tv:TableView
						Grid.Row="1"
						AutoGenerateColumns="False"
						BorderThickness="0"
						CanSortColumns="True"
						IsReadOnly="True"
						ItemsSource="{x:Bind ViewModel.OError, Mode=OneWay}"
						RowDetailsVisibilityMode="Collapsed">
						<tv:TableView.Columns>
							<tv:TableViewTextColumn Width="120" Binding="{Binding Status}" Header="Action" />
							<tv:TableViewTextColumn Width="*" Binding="{Binding Message}" Header="Description" />
						</tv:TableView.Columns>
					</tv:TableView>
				</Grid>
			</Border>
		</Grid>

		<ProgressBar
			Grid.Row="3"
			Height="10"
			HorizontalAlignment="Stretch"
			Maximum="{x:Bind ViewModel.MaxCount, Mode=OneWay}"
			Value="{x:Bind ViewModel.TotalProcessed, Mode=OneWay}" />

		<Grid Grid.Row="4" ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="14">
				<TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
				<TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.SkippedText, Mode=OneWay}" />
				<StackPanel VerticalAlignment="Center" Spacing="2">
					<TextBlock Text="{x:Bind ViewModel.DownloadedText, Mode=OneWay}" />
					<TextBlock Text="{x:Bind ViewModel.SessionDownloadedText, Mode=OneWay}" />
				</StackPanel>
				<StackPanel VerticalAlignment="Center" Spacing="2">
					<TextBlock Text="{x:Bind ViewModel.UploadedText, Mode=OneWay}" />
					<TextBlock Text="{x:Bind ViewModel.SessionUploadedText, Mode=OneWay}" />
				</StackPanel>
			</StackPanel>

			<StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
				<Button Command="{x:Bind ViewModel.OpenLogsFolderCommand}" Content="Logs Folder" />
				<Button Click="CopyDiagnostics_Click" Content="Copy Diagnostics" />
				<Button Command="{x:Bind ViewModel.ClearLogsCommand}" Content="Clear" />
				<CheckBox Content="Close When Complete" IsChecked="{x:Bind ViewModel.AutoClose, Mode=TwoWay}" />
				<Button Command="{x:Bind ViewModel.CancelCommand}" Content="Cancel" />
				<Button Click="Close_Click" Content="Close" />
			</StackPanel>
		</Grid>
	</Grid>
</Page>
