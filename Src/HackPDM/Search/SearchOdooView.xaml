<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="HackPDM.Search.SearchOdooView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="using:HackPDM.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:services="using:HackPDM.Core.Services"
	xmlns:tv="using:WinUI.TableView"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
	mc:Ignorable="d">
	<Page.Resources>
		<common:OperatorConverter x:Key="OperatorConverter" />
	</Page.Resources>

	<Grid Margin="16" RowSpacing="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border
			Grid.Row="0"
			Padding="14"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="6">
			<Grid ColumnSpacing="20">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="1.15*" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" Spacing="10">
					<TextBlock FontSize="12" FontWeight="SemiBold" Text="Filename &amp; Scope" />
					<Grid ColumnSpacing="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="86" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="84" />
						</Grid.ColumnDefinitions>
						<ComboBox
							Grid.Column="0"
							HorizontalAlignment="Stretch"
							Header="Match"
							IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
							ItemsSource="{x:Bind ViewModel.OperatorList}"
							SelectedItem="{x:Bind ViewModel.SelectedComparer, Mode=TwoWay}">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="services:OperatorsRow">
									<TextBlock Text="{Binding OpRepr}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
						<TextBox
							Grid.Column="1"
							HorizontalAlignment="Stretch"
							Header="Filename"
							KeyDown="FileNameTextbox_KeyDown"
							PlaceholderText="Search by filename…"
							Text="{x:Bind ViewModel.FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
						<TextBox
							Grid.Column="2"
							Header="Max"
							KeyDown="FileNameTextbox_KeyDown"
							Text="{x:Bind ViewModel.MaxResults, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
					</Grid>

					<StackPanel Orientation="Horizontal" Spacing="16">
						<CheckBox
							MinWidth="0"
							Content="Checked Out to Me"
							IsChecked="{x:Bind ViewModel.CheckedOutMe, Mode=TwoWay}"
							IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
						<CheckBox
							MinWidth="0"
							Content="Local Only"
							IsChecked="{x:Bind ViewModel.LocalOnly, Mode=TwoWay}"
							IsEnabled="{x:Bind ViewModel.IsLocalOnlyEnabled, Mode=OneWay}" />
						<CheckBox
							MinWidth="0"
							Content="Deleted Locally"
							IsChecked="{x:Bind ViewModel.DeletedRemotely, Mode=TwoWay}"
							IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
					</StackPanel>
				</StackPanel>

				<Border Grid.Column="1" Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

				<StackPanel Grid.Column="2" Spacing="10">
					<TextBlock FontSize="12" FontWeight="SemiBold" Text="Property Filter Builder" />
					<Grid ColumnSpacing="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="82" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<ComboBox
							Grid.Column="0"
							HorizontalAlignment="Stretch"
							Header="Property"
							IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
							ItemsSource="{x:Bind ViewModel.PropertiesSearchable}"
							SelectedItem="{x:Bind ViewModel.SelectedProperty, Mode=TwoWay}">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="services:SearchPropertiesRow">
									<TextBlock Text="{Binding Name}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>

						<ComboBox
							Grid.Column="1"
							HorizontalAlignment="Stretch"
							Header="Comparer"
							IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
							ItemsSource="{x:Bind ViewModel.OperatorList}"
							SelectedItem="{x:Bind ViewModel.SelectedPropertyOperator, Mode=TwoWay}">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="services:OperatorsRow">
									<TextBlock Text="{Binding OpRepr}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>

						<TextBox
							Grid.Column="2"
							HorizontalAlignment="Stretch"
							Header="Value"
							IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
							KeyDown="PropertyValue_KeyDown"
							PlaceholderText="Property value…"
							Text="{x:Bind ViewModel.PropertyValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

						<Button
							Grid.Column="3"
							MinWidth="84"
							VerticalAlignment="Bottom"
							Command="{x:Bind ViewModel.AddPropertyCommand}"
							Content="Add Rule"
							IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
					</Grid>

					<StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
						<Button Command="{x:Bind ViewModel.DeletePropertiesCommand}" Content="Remove Selected Rule" IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
						<Button Command="{x:Bind ViewModel.ResetPropertiesCommand}" Content="Clear Rules" IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
					</StackPanel>
				</StackPanel>
			</Grid>
		</Border>

		<Border
			Grid.Row="1"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="6">
			<tv:TableView
				x:Name="OdooSearchPropList"
				Height="104"
				AutoGenerateColumns="False"
				BorderThickness="0"
				IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
				IsReadOnly="True"
				ItemsSource="{x:Bind ViewModel.PropertiesActive}">
				<tv:TableView.Columns>
					<tv:TableViewTextColumn Width="2*" Binding="{Binding Name}" Header="Property Name" />
					<tv:TableViewTextColumn Width="1*" Binding="{Binding Comparer, Converter={StaticResource OperatorConverter}}" Header="Comparer" />
					<tv:TableViewTextColumn Width="2*" Binding="{Binding Value}" Header="Value" />
				</tv:TableView.Columns>
			</tv:TableView>
		</Border>

		<Border
			Grid.Row="2"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="6">
			<tv:TableView
				x:Name="OdooSearchResults"
				AutoGenerateColumns="False"
				BorderThickness="0"
				DoubleTapped="Results_DoubleTapped"
				IsReadOnly="True"
				ItemsSource="{x:Bind ViewModel.SearchResultsList, Mode=OneWay}"
				SelectionMode="Extended">
				<tv:TableView.Columns>
					<tv:TableViewTextColumn Width="320" Binding="{Binding Name}" Header="File Name" />
					<tv:TableViewTextColumn Width="*" Binding="{Binding Directory}" Header="File Path" />
				</tv:TableView.Columns>
				<tv:TableView.ContextFlyout>
					<MenuFlyout>
						<MenuFlyoutItem Click="LocateSelected_Click" Text="Show in File Manager" />
						<MenuFlyoutSeparator />
						<MenuFlyoutSubItem Text="Checkout">
							<MenuFlyoutItem Command="{x:Bind ViewModel.CheckoutCommand}" Text="Checkout" />
							<MenuFlyoutItem Command="{x:Bind ViewModel.CheckoutAndOpenCommand}" Text="Checkout and Open" />
						</MenuFlyoutSubItem>
						<MenuFlyoutItem Command="{x:Bind ViewModel.UndoCheckoutCommand}" Text="Undo Checkout" />
						<MenuFlyoutItem Command="{x:Bind ViewModel.OpenCommand}" Text="Open" />
					</MenuFlyout>
				</tv:TableView.ContextFlyout>
			</tv:TableView>
		</Border>

		<Grid Grid.Row="3" ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Orientation="Horizontal" Spacing="8">
				<Button Click="Close_Click" Content="Close" />
				<Button Command="{x:Bind ViewModel.ResetCommand}" Content="Reset" />
			</StackPanel>

			<StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
				<ProgressRing Width="18" Height="18" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
				<TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SearchStatusText, Mode=OneWay}" />
			</StackPanel>

			<Button
				Grid.Column="2"
				MinWidth="180"
				Command="{x:Bind ViewModel.SearchCommand}"
				Content="Search"
				Style="{ThemeResource AccentButtonStyle}" />
		</Grid>
	</Grid>
</Page>
