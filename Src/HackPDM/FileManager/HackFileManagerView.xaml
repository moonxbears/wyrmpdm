<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="HackPDM.FileManager.HackFileManagerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:common="using:HackPDM.Common"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:tv="using:WinUI.TableView"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
	mc:Ignorable="d">
	<Page.Resources>
		<common:FileSizeConverter x:Key="FileSizeFormatter" />
		<common:LocalDateTimeConverter x:Key="LocalDateFormatter" />
		<common:TypeIconConverter x:Key="TypeIcon" />
		<common:StatusIconConverter x:Key="StatusIcon" />
		<common:FileStatusDescriptionConverter x:Key="StatusDescription" />
		<common:StatusRowBackgroundConverter x:Key="StatusRowBackground" />
		<common:StatusTextBrushConverter x:Key="StatusTextBrush" />

		<DataTemplate x:Key="IconCellTemplate">
			<Canvas Width="28" Height="22" Margin="0,0,4,0" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Status, Converter={StaticResource StatusDescription}}">
				<Image Canvas.Left="0" Canvas.Top="1" Width="20" Height="20" Source="{Binding Type, Converter={StaticResource TypeIcon}}" />
				<Image Canvas.Left="10" Canvas.Top="0" Width="14" Height="14" Source="{Binding Status, Converter={StaticResource StatusIcon}}" Stretch="UniformToFill" />
			</Canvas>
		</DataTemplate>

		<DataTemplate x:Key="StatusCellTemplate">
			<TextBlock
				Padding="4,0"
				VerticalAlignment="Center"
				FontWeight="SemiBold"
				Foreground="{Binding Status, Converter={StaticResource StatusTextBrush}}"
				Text="{Binding Status}"
				ToolTipService.ToolTip="{Binding Status, Converter={StaticResource StatusDescription}}" />
		</DataTemplate>

		<DataTemplate x:Key="SizeCellTemplate">
			<TextBlock
				Padding="5,0"
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				Text="{Binding Size, Converter={StaticResource FileSizeFormatter}}"
				TextAlignment="Right" />
		</DataTemplate>

		<DataTemplate x:Key="GroupHeaderTemplate">
			<Border
				Margin="0,4,0,2"
				Padding="10,6"
				Background="{ThemeResource SubtleFillColorSecondaryBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="4">
				<Grid ColumnSpacing="8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<FontIcon Grid.Column="0" VerticalAlignment="Center" FontSize="10" Glyph="{Binding ChevronGlyph}" />
					<TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding DisplayKey}" TextTrimming="CharacterEllipsis" />
					<Border Grid.Column="2" Padding="6,1" VerticalAlignment="Center" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
						<TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding CountText}" />
					</Border>
				</Grid>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="GroupedEntryRowTemplate">
			<Grid MinHeight="26" Padding="14,1,6,1" Background="{Binding Status, Converter={StaticResource StatusRowBackground}}" ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="32" />
					<ColumnDefinition Width="*" MinWidth="160" />
					<ColumnDefinition Width="75" />
					<ColumnDefinition Width="75" />
					<ColumnDefinition Width="105" />
					<ColumnDefinition Width="95" />
					<ColumnDefinition Width="140" />
					<ColumnDefinition Width="140" />
				</Grid.ColumnDefinitions>
				<Canvas Grid.Column="0" Width="28" Height="22" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Status, Converter={StaticResource StatusDescription}}">
					<Image Canvas.Left="0" Canvas.Top="1" Width="20" Height="20" Source="{Binding Type, Converter={StaticResource TypeIcon}}" />
					<Image Canvas.Left="10" Canvas.Top="0" Width="14" Height="14" Source="{Binding Status, Converter={StaticResource StatusIcon}}" Stretch="UniformToFill" />
				</Canvas>
				<TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
				<TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Type}" TextTrimming="CharacterEllipsis" />
				<TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Size, Converter={StaticResource FileSizeFormatter}}" TextAlignment="Right" />
				<TextBlock Grid.Column="4" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource StatusTextBrush}}" Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Status, Converter={StaticResource StatusDescription}}" />
				<TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{Binding Checkout}" TextTrimming="CharacterEllipsis" />
				<TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{Binding LocalDate, Converter={StaticResource LocalDateFormatter}}" TextTrimming="CharacterEllipsis" />
				<TextBlock Grid.Column="7" VerticalAlignment="Center" Text="{Binding RemoteDate, Converter={StaticResource LocalDateFormatter}}" TextTrimming="CharacterEllipsis" />
			</Grid>
		</DataTemplate>

		<common:EntryGroupTemplateSelector
			x:Key="EntryGroupTemplateSelector"
			EntryRowTemplate="{StaticResource GroupedEntryRowTemplate}"
			GroupHeaderTemplate="{StaticResource GroupHeaderTemplate}" />

		<Style TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
		</Style>
	</Page.Resources>

	<Grid Margin="10" RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Breadcrumb Bar  -->
		<Border
			Grid.Row="0"
			Padding="6,4"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="6">
			<Grid ColumnSpacing="6">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
					<ToggleButton x:Name="ToggleFolderPaneButton" Padding="6,5" Click="ToggleFolderPane_Click" IsChecked="True" ToolTipService.ToolTip="Show or hide folders panel">
						<FontIcon FontSize="13" Glyph="&#xE8A0;" />
					</ToggleButton>
					<Button x:Name="NavigateUpButton" Padding="6,5" Click="NavigateUp_Click" IsEnabled="False" ToolTipService.ToolTip="Go up one folder (Alt+Up)">
						<FontIcon FontSize="12" Glyph="&#xE74A;" />
					</Button>
				</StackPanel>

				<BreadcrumbBar x:Name="OdooDirectoryBreadcrumb" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{x:Bind BreadcrumbPath}">
					<BreadcrumbBar.ItemTemplate>
						<DataTemplate x:DataType="common:TreeData">
							<StackPanel Padding="4,2" Orientation="Horizontal" Spacing="6" ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
								<common:FolderIcon VerticalAlignment="Center" IconSize="15" IsOpen="False" IsRoot="{x:Bind IsRootNode, Mode=OneWay}" Origin="{x:Bind Origin, Mode=OneWay}" />
								<TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="{x:Bind NameFontWeight, Mode=OneWay}" Text="{x:Bind Name}" />
							</StackPanel>
						</DataTemplate>
					</BreadcrumbBar.ItemTemplate>
				</BreadcrumbBar>

				<StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
					<Button x:Name="SubfolderMenuButton" Padding="8,4" Click="SubfolderMenuButton_Click" Visibility="Collapsed">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<FontIcon FontSize="12" Glyph="&#xE8B7;" />
							<TextBlock x:Name="SubfolderMenuLabel" VerticalAlignment="Center" Text="Subfolders" />
							<FontIcon FontSize="9" Glyph="&#xE70D;" />
						</StackPanel>
					</Button>
					<Button x:Name="CopyPathButton" Padding="8,4" Click="CopyPath_Click" ToolTipService.ToolTip="Copy vault folder path">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<FontIcon x:Name="CopyPathIcon" FontSize="12" Glyph="&#xE8C8;" />
							<TextBlock x:Name="CopyPathLabel" VerticalAlignment="Center" Text="Copy path" />
						</StackPanel>
					</Button>
					<Border x:Name="CurrentFolderOriginPill" Padding="8,4" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<Ellipse x:Name="CurrentFolderOriginDot" Width="7" Height="7" VerticalAlignment="Center" Fill="#C69749" />
							<TextBlock x:Name="CurrentFolderOriginText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</Border>

		<!--  3-Pane Workspace: Folders | (Entries / Details + Preview)  -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition x:Name="FoldersColumn" Width="260" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!--  Folders Panel  -->
			<Border
				x:Name="FoldersPaneCard"
				Grid.Column="0"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="6">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Border Grid.Row="0" Padding="8,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
						<Grid>
							<StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
								<common:FolderIcon IconSize="15" IsOpen="True" IsRoot="True" Origin="Synced" />
								<TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Folders" />
							</StackPanel>
							<StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
								<Button Padding="5,4" Click="ExpandAllFolders_Click" ToolTipService.ToolTip="Expand all folders">
									<FontIcon FontSize="10" Glyph="&#xE70D;" />
								</Button>
								<Button Padding="5,4" Click="CollapseAllFolders_Click" ToolTipService.ToolTip="Collapse all folders">
									<FontIcon FontSize="10" Glyph="&#xE70E;" />
								</Button>
								<Button Padding="5,4" Click="Refresh_Click" ToolTipService.ToolTip="Refresh folder tree (F5)">
									<FontIcon FontSize="10" Glyph="&#xE72C;" />
								</Button>
							</StackPanel>
						</Grid>
					</Border>

					<Grid Grid.Row="1" Margin="8,6,8,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBox x:Name="FolderFilterBox" MinHeight="28" Padding="8,4" FontSize="11" PlaceholderText="Filter folders…" TextChanged="FolderFilterBox_TextChanged" />
						<Button x:Name="ClearFilterButton" Grid.Column="1" Margin="4,0,0,0" Padding="6,4" Click="ClearFilterButton_Click" Visibility="Collapsed">
							<FontIcon FontSize="10" Glyph="&#xE711;" />
						</Button>
					</Grid>

					<Grid Grid.Row="2">
						<TreeView
							x:Name="OdooDirectoryTree"
							Padding="4"
							BorderThickness="0"
							CanDragItems="False"
							ScrollViewer.HorizontalScrollBarVisibility="Auto"
							ScrollViewer.VerticalScrollBarVisibility="Auto">
							<TreeView.ContextFlyout>
								<MenuFlyout>
									<MenuFlyoutSubItem x:Name="TreeDownload" Text="Download">
										<MenuFlyoutItem Command="{x:Bind ViewModel.GetLatestDirectoryCommand}" Text="All" />
										<MenuFlyoutItem Command="{x:Bind ViewModel.GetLatestDirectoryTopCommand}" Text="Top Directory" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSeparator />
									<MenuFlyoutItem Command="{x:Bind ViewModel.CheckoutDirectoryCommand}" Text="Checkout" />
									<MenuFlyoutItem Command="{x:Bind ViewModel.UndoCheckoutDirectoryCommand}" Text="Undo Checkout" />
									<MenuFlyoutSeparator />
									<MenuFlyoutItem Command="{x:Bind ViewModel.CommitDirectoryCommand}" Text="Commit" />
									<MenuFlyoutSeparator />
									<MenuFlyoutSubItem Text="Delete">
										<MenuFlyoutItem Command="{x:Bind ViewModel.LocalDeleteDirectoryCommand}" Text="Local" />
										<MenuFlyoutItem Command="{x:Bind ViewModel.LogicalDeleteDirectoryCommand}" Text="Logical" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSubItem x:Name="TreeUndelete" Text="Restore">
										<MenuFlyoutItem Command="{x:Bind ViewModel.RestoreDirectoryRecursiveCommand}" Text="All" />
										<MenuFlyoutItem Command="{x:Bind ViewModel.RestoreDirectoryCommand}" Text="Top Directory" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSeparator />
									<MenuFlyoutItem Command="{x:Bind ViewModel.OpenDirectoryCommand}" Text="Open Directory" />
								</MenuFlyout>
							</TreeView.ContextFlyout>
							<TreeView.ItemTemplate>
								<DataTemplate x:DataType="common:TreeData">
									<TreeViewItem IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" Loaded="TreeViewItem_Loaded" ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<common:FolderIcon VerticalAlignment="Center" IconSize="16" IsOpen="{x:Bind IsExpanded, Mode=OneWay}" IsRoot="{x:Bind IsRootNode, Mode=OneWay}" Origin="{x:Bind Origin, Mode=OneWay}" />
											<TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="{x:Bind NameFontWeight, Mode=OneWay}" Text="{x:Bind Name}" />
											<Border Padding="5,0" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Visibility="{x:Bind SubfolderCountVisibility, Mode=OneWay}">
												<TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind SubfolderCountText, Mode=OneWay}" />
											</Border>
											<Border Padding="4,0" VerticalAlignment="Center" Background="#222EA043" CornerRadius="4" Visibility="{x:Bind LocalBadgeVisibility, Mode=OneWay}">
												<TextBlock FontSize="9" Foreground="#4CC36B" Text="Local" />
											</Border>
											<Border Padding="4,0" VerticalAlignment="Center" Background="#221F88E5" CornerRadius="4" Visibility="{x:Bind RemoteBadgeVisibility, Mode=OneWay}">
												<TextBlock FontSize="9" Foreground="#58B4FF" Text="Server" />
											</Border>
										</StackPanel>
									</TreeViewItem>
								</DataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>

						<StackPanel x:Name="EmptyTreeFilterPanel" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Visibility="Collapsed">
							<TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No matching folders" />
							<Button HorizontalAlignment="Center" Click="ClearFilterButton_Click" Content="Show all folders" />
						</StackPanel>

						<Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="{x:Bind ViewModel.IsTreeLoading, Mode=OneWay}">
							<StackPanel Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
								<ProgressRing Width="28" Height="28" HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsTreeLoading, Mode=OneWay}" />
								<TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Loading Folders…" />
								<TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.TreeLoadingStatus, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" />
							</StackPanel>
						</Border>
					</Grid>

					<Border Grid.Row="3" Padding="10,5" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
						<TextBlock x:Name="TreeSummaryText" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Loading folders…" TextTrimming="CharacterEllipsis" />
					</Border>
				</Grid>
			</Border>

			<common:PaneSplitter x:Name="FoldersSplitter" Grid.Column="1" DragDelta="FoldersSplitter_DragDelta" Orientation="Vertical" />

			<!--  Right Side: Entries Top + Details/Preview Bottom  -->
			<Grid Grid.Column="2">
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
					<RowDefinition x:Name="InspectorRow" Height="250" />
				</Grid.RowDefinitions>

				<!--  Entries Panel  -->
				<Border
					Grid.Row="0"
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="6">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TabView x:Name="ListTabs" Grid.Row="0" IsAddTabButtonVisible="False">
							<TabView.TabStripFooter>
								<StackPanel Padding="6,2,8,2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
									<Button Padding="7,4" Click="Refresh_Click" ToolTipService.ToolTip="Refresh view (F5)">
										<StackPanel Orientation="Horizontal" Spacing="5">
											<FontIcon FontSize="11" Glyph="&#xE72C;" />
											<TextBlock VerticalAlignment="Center" Text="Refresh" />
										</StackPanel>
									</Button>
									<Button Padding="7,4" Click="Search_Click" ToolTipService.ToolTip="Search vault (Ctrl+F)">
										<StackPanel Orientation="Horizontal" Spacing="5">
											<FontIcon FontSize="11" Glyph="&#xE721;" />
											<TextBlock VerticalAlignment="Center" Text="Search" />
										</StackPanel>
									</Button>
									<ToggleButton Padding="7,4" IsChecked="{x:Bind ViewModel.IsGroupingEnabled, Mode=TwoWay}" ToolTipService.ToolTip="Toggle grouping">
										<StackPanel Orientation="Horizontal" Spacing="5">
											<FontIcon FontSize="11" Glyph="&#xE8FD;" />
											<TextBlock VerticalAlignment="Center" Text="Grouped" />
										</StackPanel>
									</ToggleButton>
									<Button Padding="7,4" ToolTipService.ToolTip="Group entries by field">
										<StackPanel Orientation="Horizontal" Spacing="4">
											<TextBlock VerticalAlignment="Center" Text="Group By" />
											<FontIcon FontSize="9" Glyph="&#xE70D;" />
										</StackPanel>
										<Button.Flyout>
											<MenuFlyout x:Name="GroupByToolbarFlyout" />
										</Button.Flyout>
									</Button>
									<ToggleButton Padding="7,4" IsChecked="{x:Bind ViewModel.ShowInactive, Mode=TwoWay}" ToolTipService.ToolTip="Show deleted/inactive files">
										<StackPanel Orientation="Horizontal" Spacing="5">
											<FontIcon FontSize="11" Glyph="&#xE890;" />
											<TextBlock VerticalAlignment="Center" Text="Inactive" />
										</StackPanel>
									</ToggleButton>
									<ToggleButton x:Name="Anchor" Padding="7,4" Checked="Anchor_Checked" ToolTipService.ToolTip="Keep window always on top" Unchecked="Anchor_Checked">
										<StackPanel Orientation="Horizontal" Spacing="5">
											<FontIcon FontSize="11" Glyph="&#xE718;" />
											<TextBlock VerticalAlignment="Center" Text="Pin" />
										</StackPanel>
									</ToggleButton>
									<Button Padding="7,4" Click="StatusWindow_Click" ToolTipService.ToolTip="Open Status Log (Alt+S)">
										<FontIcon FontSize="11" Glyph="&#xE9D9;" />
									</Button>
								</StackPanel>
							</TabView.TabStripFooter>

							<TabViewItem x:Name="RootEntryList" Header="Entries" IsClosable="False">
								<Grid>
									<common:EntryTableView
										x:Name="OdooEntryList"
										AutoGenerateColumns="False"
										CanSortColumns="True"
										IsReadOnly="True"
										SelectionMode="Extended"
										SelectionUnit="Row"
										ShowDragRectangle="False">
										<tv:TableView.Columns>
											<tv:TableViewTemplateColumn Width="34" CanReorder="True" CanResize="True" CellTemplate="{StaticResource IconCellTemplate}" />
											<tv:TableViewTextColumn Width="200" Binding="{Binding Name}" Header="Name" SortMemberPath="Name" />
											<tv:TableViewTextColumn Width="70" Binding="{Binding Type}" Header="Type" SortMemberPath="Type" />
											<tv:TableViewTemplateColumn Width="85" CellTemplate="{StaticResource SizeCellTemplate}" Header="Size" SortMemberPath="Size" />
											<tv:TableViewTemplateColumn Width="75" CellTemplate="{StaticResource StatusCellTemplate}" Header="Status" SortMemberPath="Status" />
											<tv:TableViewTextColumn Width="105" Binding="{Binding Checkout}" Header="Checkout" SortMemberPath="Checkout" />
											<tv:TableViewTextColumn Width="150" Binding="{Binding LocalDate, Converter={StaticResource LocalDateFormatter}}" Header="Local Date" SortMemberPath="LocalDate" />
											<tv:TableViewTextColumn Width="150" Binding="{Binding RemoteDate, Converter={StaticResource LocalDateFormatter}}" Header="Remote Date" SortMemberPath="RemoteDate" />
											<tv:TableViewTextColumn Width="*" MinWidth="200" Binding="{Binding FullName}" Header="Full Name" SortMemberPath="FullName" />
										</tv:TableView.Columns>
										<tv:TableView.ContextFlyout>
											<MenuFlyout>
												<MenuFlyoutSubItem x:Name="EntryOpen" Text="Open">
													<MenuFlyoutItem Command="{x:Bind ViewModel.OpenSelectedLatestRemoteCommand}" Text="Preview Latest Remote" />
													<MenuFlyoutItem Command="{x:Bind ViewModel.OpenSelectedLatestLocalCommand}" Text="Latest Local" />
													<MenuFlyoutItem Command="{x:Bind ViewModel.OpenSelectedFoldersCommand}" Text="File Directory" />
												</MenuFlyoutSubItem>
												<MenuFlyoutItem Command="{x:Bind ViewModel.GetLatestSelectedCommand}" Text="Download" />
												<MenuFlyoutSeparator />
												<MenuFlyoutItem Command="{x:Bind ViewModel.CheckoutSelectedCommand}" Text="Checkout" />
												<MenuFlyoutItem Command="{x:Bind ViewModel.UndoCheckoutSelectedCommand}" Text="Undo Checkout" />
												<MenuFlyoutSeparator />
												<MenuFlyoutSubItem x:Name="EntryGroupBy" Text="Group By" />
												<MenuFlyoutSeparator />
												<MenuFlyoutItem Command="{x:Bind ViewModel.CommitSelectedCommand}" Text="Commit" />
												<MenuFlyoutItem Command="{x:Bind ViewModel.UploadPreviewImageCommand}" Text="Upload Preview Image" />
												<MenuFlyoutSeparator />
												<MenuFlyoutSubItem x:Name="EntryDelete" Text="Delete">
													<MenuFlyoutItem Command="{x:Bind ViewModel.LocalDeleteSelectedCommand}" Text="Local" />
													<MenuFlyoutItem Command="{x:Bind ViewModel.LogicalDeleteSelectedCommand}" Text="Logical" />
													<MenuFlyoutItem Command="{x:Bind ViewModel.PermanentDeleteSelectedCommand}" Text="Permanent" />
												</MenuFlyoutSubItem>
											</MenuFlyout>
										</tv:TableView.ContextFlyout>
									</common:EntryTableView>

									<!--  Grouped ListView for non-Windows Uno Desktop  -->
									<Grid x:Name="GroupedEntryContainer" Visibility="Collapsed">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>
										<Border Grid.Row="0" Padding="8,4" Background="{ThemeResource SubtleFillColorTertiaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
											<Grid ColumnSpacing="8">
												<TextBlock x:Name="GroupedByLabel" VerticalAlignment="Center" FontWeight="SemiBold" Text="Grouped by Status" />
												<StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
													<Button Padding="6,3" Click="ExpandAllGroups_Click" ToolTipService.ToolTip="Expand all groups">
														<FontIcon FontSize="10" Glyph="&#xE70D;" />
													</Button>
													<Button Padding="6,3" Click="CollapseAllGroups_Click" ToolTipService.ToolTip="Collapse all groups">
														<FontIcon FontSize="10" Glyph="&#xE70E;" />
													</Button>
												</StackPanel>
											</Grid>
										</Border>
										<Border Grid.Row="1" Padding="14,3,6,3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
											<Grid ColumnSpacing="8">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="32" />
													<ColumnDefinition Width="*" MinWidth="160" />
													<ColumnDefinition Width="75" />
													<ColumnDefinition Width="75" />
													<ColumnDefinition Width="105" />
													<ColumnDefinition Width="95" />
													<ColumnDefinition Width="140" />
													<ColumnDefinition Width="140" />
												</Grid.ColumnDefinitions>
												<Button Grid.Column="1" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Name" FontWeight="SemiBold" Tag="Name" />
												<Button Grid.Column="2" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Type" FontWeight="SemiBold" Tag="Type" />
												<Button Grid.Column="3" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Size" FontWeight="SemiBold" Tag="Size" />
												<Button Grid.Column="4" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Status" FontWeight="SemiBold" Tag="Status" />
												<Button Grid.Column="5" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Checkout" FontWeight="SemiBold" Tag="Checkout" />
												<Button Grid.Column="6" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Local Date" FontWeight="SemiBold" Tag="LocalDate" />
												<Button Grid.Column="7" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Remote Date" FontWeight="SemiBold" Tag="RemoteDate" />
											</Grid>
										</Border>
										<ListView
											x:Name="GroupedEntryList"
											Grid.Row="2"
											HorizontalContentAlignment="Stretch"
											IsItemClickEnabled="True"
											ItemTemplateSelector="{StaticResource EntryGroupTemplateSelector}"
											SelectionMode="Extended">
											<ListView.ItemContainerStyle>
												<Style TargetType="ListViewItem">
													<Setter Property="HorizontalContentAlignment" Value="Stretch" />
													<Setter Property="Padding" Value="4,0" />
													<Setter Property="MinHeight" Value="0" />
												</Style>
											</ListView.ItemContainerStyle>
										</ListView>
									</Grid>

									<ProgressBar
										Height="3"
										VerticalAlignment="Top"
										IsHitTestVisible="False"
										IsIndeterminate="{x:Bind ViewModel.IsEntriesProgressIndeterminate, Mode=OneWay}"
										Maximum="100"
										Minimum="0"
										Visibility="{x:Bind ViewModel.IsEntriesLoading, Mode=OneWay}"
										Value="{x:Bind ViewModel.EntriesLoadingPercent, Mode=OneWay}" />

									<Border
										MinWidth="280"
										Padding="20,16"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
										BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
										BorderThickness="1"
										CornerRadius="8"
										Visibility="{x:Bind ViewModel.IsEntriesLoading, Mode=OneWay}">
										<StackPanel HorizontalAlignment="Center" Spacing="8">
											<ProgressRing Width="28" Height="28" HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsEntriesLoading, Mode=OneWay}" />
											<TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.EntriesLoadingStatus, Mode=OneWay}" />
										</StackPanel>
									</Border>

									<TextBlock
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontSize="13"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										IsHitTestVisible="False"
										Text="This folder has no entries"
										Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" />
								</Grid>
							</TabViewItem>

							<TabViewItem x:Name="ChangesTab" Header="{x:Bind ViewModel.ChangesTabHeader, Mode=OneWay}" IsClosable="False">
								<Grid Padding="8" ColumnSpacing="10">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>

									<Border Grid.Column="0" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
										<Grid RowSpacing="8">
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto" />
												<RowDefinition Height="*" />
											</Grid.RowDefinitions>
											<Grid ColumnDefinitions="*,Auto">
												<TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.LocalChangesHeader, Mode=OneWay}" />
												<Button Grid.Column="1" Padding="10,4" Command="{x:Bind ViewModel.CommitDirectoryCommand}" Content="Commit Folder" />
											</Grid>
											<tv:TableView x:Name="HackChangesList" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{x:Bind ViewModel.LocalChanges}">
												<tv:TableView.Columns>
													<tv:TableViewTextColumn Width="130" Binding="{Binding Name}" Header="File Name" />
													<tv:TableViewTextColumn Width="*" Binding="{Binding Status, Converter={StaticResource StatusDescription}}" Header="Status" />
													<tv:TableViewTextColumn Width="78" Binding="{Binding Size, Converter={StaticResource FileSizeFormatter}}" Header="Size" />
													<tv:TableViewTextColumn Width="145" Binding="{Binding LocalDate, Converter={StaticResource LocalDateFormatter}}" Header="Local Date" />
												</tv:TableView.Columns>
											</tv:TableView>
										</Grid>
									</Border>

									<Border Grid.Column="1" Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
										<Grid RowSpacing="8">
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto" />
												<RowDefinition Height="*" />
											</Grid.RowDefinitions>
											<Grid ColumnDefinitions="*,Auto">
												<TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.RemoteChangesHeader, Mode=OneWay}" />
												<Button Grid.Column="1" Padding="10,4" Command="{x:Bind ViewModel.GetLatestDirectoryTopCommand}" Content="Download Folder" />
											</Grid>
											<tv:TableView x:Name="OdooChangesList" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{x:Bind ViewModel.RemoteChanges}">
												<tv:TableView.Columns>
													<tv:TableViewTextColumn Width="130" Binding="{Binding Name}" Header="File Name" />
													<tv:TableViewTextColumn Width="*" Binding="{Binding Status, Converter={StaticResource StatusDescription}}" Header="Status" />
													<tv:TableViewTextColumn Width="78" Binding="{Binding Size, Converter={StaticResource FileSizeFormatter}}" Header="Size" />
													<tv:TableViewTextColumn Width="145" Binding="{Binding RemoteDate, Converter={StaticResource LocalDateFormatter}}" Header="Remote Date" />
												</tv:TableView.Columns>
											</tv:TableView>
										</Grid>
									</Border>
								</Grid>
							</TabViewItem>
						</TabView>

						<Border Grid.Row="1" Padding="10,5" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
							<Grid ColumnDefinitions="Auto,*">
								<StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="14">
									<TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.EntriesLabel, Mode=OneWay}" />
									<TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.EntriesLabelModified, Mode=OneWay}" />
									<TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.EntriesLabelLocal, Mode=OneWay}" />
									<TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.EntriesLabelRemote, Mode=OneWay}" />
								</StackPanel>
								<TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SelectionLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
							</Grid>
						</Border>
					</Grid>
				</Border>

				<common:PaneSplitter Grid.Row="1" DragDelta="InspectorSplitter_DragDelta" Orientation="Horizontal" />

				<!--  Bottom Inspector: Details Tabs + Preview  -->
				<Grid Grid.Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition x:Name="PreviewColumn" Width="280" />
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
						<Grid>
							<TabView x:Name="VersionTabs" IsAddTabButtonVisible="False" SelectionChanged="VersionTabs_SelectionChanged">
								<TabViewItem x:Name="HistoryTab" Header="History" IsClosable="False">
									<tv:TableView x:Name="OdooHistory" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{x:Bind ViewModel.OHistories}">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="90" Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Width="130" Binding="{Binding ModUser}" Header="Mod User" />
											<tv:TableViewTextColumn Width="150" Binding="{Binding ModDate, Converter={StaticResource LocalDateFormatter}}" Header="Mod Date" />
											<tv:TableViewTextColumn Width="100" Binding="{Binding Size, Converter={StaticResource FileSizeFormatter}}" Header="Size" />
											<tv:TableViewTextColumn Width="*" MinWidth="110" Binding="{Binding RelDate, Converter={StaticResource LocalDateFormatter}}" Header="Rel Date" />
										</tv:TableView.Columns>
										<tv:TableView.ContextFlyout>
											<MenuFlyout>
												<MenuFlyoutSubItem x:Name="HistoryDownload" Text="Download">
													<MenuFlyoutItem Command="{x:Bind ViewModel.DownloadHistoryToTempCommand}" Text="Temporary" />
													<MenuFlyoutItem Command="{x:Bind ViewModel.DownloadHistoryOverwriteCommand}" Text="Overwrite" />
												</MenuFlyoutSubItem>
												<MenuFlyoutSubItem Text="Open">
													<MenuFlyoutItem Command="{x:Bind ViewModel.OpenHistoryFromTempCommand}" Text="Temporary" />
													<MenuFlyoutItem Command="{x:Bind ViewModel.OpenHistoryOverwriteCommand}" Text="Overwrite" />
												</MenuFlyoutSubItem>
												<MenuFlyoutSubItem x:Name="HistoryMove" Text="Move">
													<MenuFlyoutItem Command="{x:Bind ViewModel.MoveHistoryToTempCommand}" Text="Temporary" />
													<MenuFlyoutItem Command="{x:Bind ViewModel.MoveHistoryToWorkingCommand}" Text="Overwrite" />
												</MenuFlyoutSubItem>
											</MenuFlyout>
										</tv:TableView.ContextFlyout>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="ParentTab" Header="Where Used" IsClosable="False">
									<tv:TableView x:Name="OdooParents" AutoGenerateColumns="False" CanSortColumns="False" IsReadOnly="True" ItemsSource="{x:Bind ViewModel.OParents}" RowDetailsVisibilityMode="Collapsed">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="90" Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Width="220" Binding="{Binding Name}" Header="Name" />
											<tv:TableViewTextColumn Width="*" Binding="{Binding BasePath}" Header="Folder Path" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="ChildTab" Header="Dependents" IsClosable="False">
									<common:EntryTableView x:Name="OdooChildren" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{x:Bind ViewModel.OChildren}" RowDetailsVisibilityMode="Collapsed" SelectionMode="Extended" SelectionUnit="Row" ShowDragRectangle="False">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="90" Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Width="220" Binding="{Binding Name}" Header="Name" />
											<tv:TableViewTextColumn Width="*" Binding="{Binding BasePath}" Header="Folder Path" />
										</tv:TableView.Columns>
									</common:EntryTableView>
								</TabViewItem>
								<TabViewItem x:Name="PropertiesTab" Header="Properties" IsClosable="False">
									<tv:TableView AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{x:Bind ViewModel.OProperties}" RowDetailsVisibilityMode="Collapsed">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="90" Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Width="160" Binding="{Binding Name}" Header="Property" />
											<tv:TableViewTextColumn Width="140" Binding="{Binding Configuration}" Header="Configuration" />
											<tv:TableViewTextColumn Width="90" Binding="{Binding Type}" Header="Type" />
											<tv:TableViewTextColumn Width="*" Binding="{Binding ValueData}" Header="Value" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="InfoTab" Header="Info" IsClosable="False">
									<tv:TableView AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{x:Bind ViewModel.OVersions}" RowDetailsVisibilityMode="Collapsed">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="95" Binding="{Binding Id}" Header="Version Id" />
											<tv:TableViewTextColumn Width="95" Binding="{Binding FileSize, Converter={StaticResource FileSizeFormatter}}" Header="File Size" />
											<tv:TableViewTextColumn Width="105" Binding="{Binding DirectoryId}" Header="Directory Id" />
											<tv:TableViewTextColumn Width="90" Binding="{Binding NodeId}" Header="Node Id" />
											<tv:TableViewTextColumn Width="90" Binding="{Binding EntryId}" Header="Entry Id" />
											<tv:TableViewTextColumn Width="115" Binding="{Binding AttachmentId}" Header="Attachment Id" />
											<tv:TableViewTextColumn Width="150" Binding="{Binding ModifyDate, Converter={StaticResource LocalDateFormatter}}" Header="Modify Date" />
											<tv:TableViewTextColumn Width="180" Binding="{Binding Checksum}" Header="Checksum" />
											<tv:TableViewTextColumn Width="240" Binding="{Binding OdooCompletePath}" Header="Odoo Complete Path" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
							</TabView>
							<ProgressBar Height="3" VerticalAlignment="Top" IsHitTestVisible="False" IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsDetailsLoading, Mode=OneWay}" />
						</Grid>
					</Border>

					<common:PaneSplitter Grid.Column="1" DragDelta="PreviewSplitter_DragDelta" Orientation="Vertical" />

					<Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<Border Grid.Row="0" Padding="8,5" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
								<Grid>
									<TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Preview" />
									<Button HorizontalAlignment="Right" Padding="5,3" Command="{x:Bind ViewModel.UploadPreviewImageCommand}" ToolTipService.ToolTip="Upload custom preview image">
										<FontIcon FontSize="11" Glyph="&#xE898;" />
									</Button>
								</Grid>
							</Border>
							<Grid Grid.Row="1" Margin="8">
								<StackPanel x:Name="NoPreviewPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
									<ProgressRing Width="28" Height="28" HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsPreviewLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsPreviewLoading, Mode=OneWay}" />
									<TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.PreviewStatusText, Mode=OneWay}" />
								</StackPanel>
								<Image x:Name="OdooEntryImage" Stretch="Uniform" Visibility="{x:Bind ViewModel.IsPreviewVisible, Mode=OneWay}" />
							</Grid>
						</Grid>
					</Border>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</Page>
