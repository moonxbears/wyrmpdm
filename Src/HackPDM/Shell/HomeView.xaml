<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="HackPDM.Shell.HomeView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">
	<NavigationView
		x:Name="HomeNavigator"
		AlwaysShowHeader="False"
		BackRequested="HomeNavigator_BackRequested"
		ExpandedModeThresholdWidth="900"
		Header="HackPDM"
		IsBackButtonVisible="Auto"
		IsBackEnabled="False"
		IsSettingsVisible="False"
		IsTabStop="False"
		ItemInvoked="HomeNavigator_ItemInvoked"
		KeyDown="HomeView_KeyDown"
		PaneDisplayMode="LeftCompact"
		PaneTitle="HackPDM"
		SelectionChanged="HomeNavigator_SelectionChanged"
		SelectionFollowsFocus="Disabled">
		<NavigationView.MenuItems>
			<NavigationViewItem
				x:Name="HackNav"
				Content="File Manager"
				Tag="HackFileManager"
				ToolTipService.ToolTip="Hack File Manager (Ctrl+1)">
				<NavigationViewItem.Icon>
					<SymbolIcon Symbol="Folder" />
				</NavigationViewItem.Icon>
			</NavigationViewItem>
			<NavigationViewItemSeparator />
			<NavigationViewItem
				x:Name="ProfileNav"
				Content="Profile Manager"
				Tag="ProfileManager"
				ToolTipService.ToolTip="Profile Manager (Ctrl+2)">
				<NavigationViewItem.Icon>
					<SymbolIcon Symbol="Account" />
				</NavigationViewItem.Icon>
			</NavigationViewItem>
			<NavigationViewItem
				x:Name="ConfigNav"
				Content="Configurations"
				Tag="Configuration"
				ToolTipService.ToolTip="Server &amp; Folder Configurations (Ctrl+3)">
				<NavigationViewItem.Icon>
					<FontIcon Glyph="&#xE9E9;" />
				</NavigationViewItem.Icon>
			</NavigationViewItem>
		</NavigationView.MenuItems>

		<NavigationView.FooterMenuItems>
			<NavigationViewItem
				x:Name="SearchNav"
				Content="Search Vault"
				SelectsOnInvoked="False"
				Tag="SearchVault"
				ToolTipService.ToolTip="Search Vault (Ctrl+F)">
				<NavigationViewItem.Icon>
					<SymbolIcon Symbol="Find" />
				</NavigationViewItem.Icon>
			</NavigationViewItem>
			<NavigationViewItem
				x:Name="StatusLogNav"
				Content="Status Log"
				SelectsOnInvoked="False"
				Tag="StatusLog"
				ToolTipService.ToolTip="Status Log (Alt+S)">
				<NavigationViewItem.Icon>
					<FontIcon Glyph="&#xE9D9;" />
				</NavigationViewItem.Icon>
			</NavigationViewItem>
		</NavigationView.FooterMenuItems>

		<Frame x:Name="NavFrame" />
	</NavigationView>
</Page>
