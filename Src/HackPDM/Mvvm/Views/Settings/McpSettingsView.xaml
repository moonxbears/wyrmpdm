<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Mvvm.Views.Settings.McpSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:HackPDM.Mvvm.ViewModels.Settings"
    mc:Ignorable="d">
    <ScrollViewer x:Name="McpScrollViewer" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel
            MaxWidth="1240"
            Margin="20,14"
            HorizontalAlignment="Stretch"
            Spacing="12">

            <!--  Header  -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="MCP Server, Permissions &amp; Restore Points" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Start the embedded AI Model Context Protocol server in one click, copy live connection details, tune AI permission modes/presets/profiles, review actions live, and roll back changes."
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Border
                        Padding="10,5"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <TextBlock
                            x:Name="McpPermissionBadge"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{x:Bind ViewModel.PermissionBadgeText, Mode=OneWay}" />
                    </Border>
                    <Border
                        Padding="10,5"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <TextBlock
                            x:Name="McpStatusBadge"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.StatusBadgeText, Mode=OneWay}" />
                    </Border>
                    <Button
                        x:Name="OpenCommandPaletteFromMcpButton"
                        Click="OpenCommandPalette_Click"
                        Content="Command Palette / AI Login (Ctrl+K)"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        x:Name="RefreshMcpButton"
                        Command="{x:Bind ViewModel.RefreshAllCommand}"
                        Content="Refresh" />
                </StackPanel>
            </Grid>

            <!--  Status Feedback Banner  -->
            <InfoBar
                x:Name="McpFeedbackBanner"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasBanner, Mode=TwoWay}"
                Message="{x:Bind ViewModel.BannerText, Mode=OneWay}"
                Severity="Informational" />

            <!--  Card 0 (Live Alert): Pending AI Action Reviews Queue  -->
            <Border
                x:Name="PendingReviewsCard"
                Padding="14"
                Background="{ThemeResource InfoBarWarningSeverityBackgroundBrush}"
                BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                BorderThickness="2"
                CornerRadius="6"
                Visibility="{x:Bind ViewModel.PendingReviewsVisibility, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="PendingReviewsHeader"
                            FontSize="15"
                            FontWeight="Bold"
                            Text="{x:Bind ViewModel.PendingReviewsHeaderText, Mode=OneWay}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Review each AI-requested action below before it executes. Approving for Session lets that tool run without asking again until you switch modes or clear session approvals."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ItemsControl x:Name="PendingReviewsList" ItemsSource="{x:Bind ViewModel.PendingReviews}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:McpPendingReviewRow">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{x:Bind RiskBadge}" />
                                                </Border>
                                                <TextBlock
                                                    FontFamily="Consolas, monospace"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Text="{x:Bind ToolName}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind CategoryText}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas, monospace"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind ExpiresText}" />
                                            </StackPanel>
                                            <TextBlock
                                                FontSize="12"
                                                Text="{x:Bind ReasonText}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontFamily="Consolas, monospace"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind ArgsSummaryText}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                x:Name="ApproveReviewOnceButton"
                                                Click="ApproveReviewOnce_Click"
                                                Content="Approve Once"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Tag="{x:Bind Id}" />
                                            <Button
                                                x:Name="ApproveSessionReviewButton"
                                                Click="ApproveReviewSession_Click"
                                                Content="Approve Session"
                                                Tag="{x:Bind Id}" />
                                            <Button
                                                x:Name="DenyReviewButton"
                                                Click="DenyReview_Click"
                                                Content="Deny"
                                                Tag="{x:Bind Id}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  Card 1: Quick-Start MCP Server & Live Connection Details  -->
            <Border
                x:Name="BridgeCard"
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="12">
                    <!--  Top Action Bar  -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="Quick-Start MCP Server &amp; Connection Details (127.0.0.1 + Bearer Auth)" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Start the server with zero setup, then copy either the Stdio Auto-Attach JSON (recommended) or the Direct Streamable HTTP URL &amp; Bearer token into your AI client."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="ToggleMcpBridgeButton"
                                Command="{x:Bind ViewModel.ToggleBridgeCommand}"
                                Content="{x:Bind ViewModel.ToggleBridgeButtonText, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="CopyMcpConfigButton"
                                Command="{x:Bind ViewModel.CopyStdioConfigCommand}"
                                Content="Copy Stdio JSON" />
                            <Button
                                x:Name="CopyMcpHttpConfigButton"
                                Command="{x:Bind ViewModel.CopyHttpConfigCommand}"
                                Content="Copy HTTP JSON" />
                            <Button
                                x:Name="ResetUiDefaultsButton"
                                Command="{x:Bind ViewModel.ResetUiAndThemeDefaultsCommand}"
                                Content="Reset UI Defaults" />
                            <Button
                                x:Name="ApplyMcpSettingsButton"
                                Command="{x:Bind ViewModel.SaveBridgeSettingsCommand}"
                                Content="Save &amp; Apply" />
                        </StackPanel>
                    </Grid>

                    <!--  Live Connection Details Row (Endpoint URL + Bearer Token)  -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox
                                x:Name="McpEndpointBox"
                                FontFamily="Consolas, monospace"
                                FontSize="12"
                                Header="Streamable HTTP Endpoint URL"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.EndpointText, Mode=OneWay}" />
                            <Button
                                x:Name="CopyEndpointButton"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.CopyEndpointCommand}"
                                Content="Copy URL" />
                        </Grid>

                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBox
                                x:Name="McpTokenBox"
                                FontFamily="Consolas, monospace"
                                FontSize="12"
                                Header="Bearer Auth Token (Authorization: Bearer &lt;token&gt;)"
                                IsReadOnly="True"
                                Text="{x:Bind ViewModel.DisplayTokenText, Mode=OneWay}" />
                            <Button
                                x:Name="RevealTokenButton"
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.ToggleShowTokenCommand}"
                                Content="{x:Bind ViewModel.RevealTokenButtonText, Mode=OneWay}" />
                            <Button
                                x:Name="CopyTokenButton"
                                Grid.Column="2"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.CopyTokenCommand}"
                                Content="Copy Token" />
                        </Grid>
                    </Grid>

                    <!--  Minimal Configuration Controls Row  -->
                    <Grid ColumnDefinitions="Auto,110,Auto,110,*" ColumnSpacing="14">
                        <ToggleSwitch
                            x:Name="EnableMcpBridgeToggle"
                            MinWidth="0"
                            Header="Start on launch"
                            IsOn="{x:Bind ViewModel.IsBridgeEnabled, Mode=TwoWay}"
                            OffContent="Off"
                            OnContent="On" />
                        <TextBox
                            x:Name="McpPortBox"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Header="Port (0=auto)"
                            Text="{x:Bind ViewModel.BridgePortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ToggleSwitch
                            x:Name="AutoRestorePointsToggle"
                            Grid.Column="2"
                            MinWidth="0"
                            Header="Auto restore points"
                            IsOn="{x:Bind ViewModel.AutoRestorePoints, Mode=TwoWay}"
                            OffContent="Manual"
                            OnContent="Auto" />
                        <TextBox
                            x:Name="MaxRestorePointsBox"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Header="Max auto points"
                            Text="{x:Bind ViewModel.MaxRestorePointsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            x:Name="McpClientConfigBox"
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            FontFamily="Consolas, monospace"
                            FontSize="11"
                            Header="Stdio Launch Command (auto-discovers live GUI via mcp-bridge.json)"
                            IsReadOnly="True"
                            Text="{x:Bind ViewModel.ClientCommandPreview, Mode=OneWay}" />
                    </Grid>

                    <!--  Discovery File Path  -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Discovery file:" />
                        <TextBlock
                            x:Name="McpDiscoveryFileText"
                            FontFamily="Consolas, monospace"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.DiscoveryFileText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Card 2: AI Permissions, Execution Mode, Presets & Custom Profiles  -->
            <Border
                x:Name="PermissionsCard"
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="AI Permissions, Execution Mode, Presets &amp; Profiles" />
                            <TextBlock
                                x:Name="PermissionModeDescriptionText"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind ViewModel.ModeDescriptionText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.SessionApprovalsVisibility, Mode=OneWay}">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.SessionApprovalsText, Mode=OneWay}" />
                            <Button
                                x:Name="ClearSessionApprovalsButton"
                                Command="{x:Bind ViewModel.ClearSessionApprovalsCommand}"
                                Content="Clear Session Approvals" />
                        </StackPanel>
                    </Grid>

                    <!--  Mode + Preset/Profile + Review Settings Row  -->
                    <Grid ColumnDefinitions="260,*,Auto,105,Auto" ColumnSpacing="10">
                        <ComboBox
                            x:Name="PermissionModeCombo"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Header="Execution Mode"
                            ItemsSource="{x:Bind ViewModel.ModeOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedModeOption, Mode=TwoWay}" />

                        <ComboBox
                            x:Name="PermissionPresetCombo"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Header="Preset or Custom Profile"
                            ItemsSource="{x:Bind ViewModel.ProfileOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedProfileOption, Mode=TwoWay}" />

                        <Button
                            x:Name="ApplyPermissionPresetButton"
                            Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind ViewModel.ApplySelectedProfileCommand}"
                            Content="Reset to Preset" />

                        <TextBox
                            x:Name="ReviewTimeoutBox"
                            Grid.Column="3"
                            VerticalAlignment="Bottom"
                            Header="Timeout (s)"
                            Text="{x:Bind ViewModel.ReviewTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox
                            x:Name="PromptDialogWhenHiddenCheck"
                            Grid.Column="4"
                            VerticalAlignment="Bottom"
                            Content="Popup when on other page"
                            IsChecked="{x:Bind ViewModel.PromptDialogWhenHidden, Mode=TwoWay}" />
                    </Grid>

                    <!--  Custom Profile Save / Delete Bar  -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox
                            x:Name="NewProfileNameBox"
                            PlaceholderText="Save current mode &amp; toggles as custom profile name (e.g. Safe Shop Floor)..."
                            Text="{x:Bind ViewModel.NewProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            x:Name="SavePermissionProfileButton"
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.SaveCurrentAsProfileCommand}"
                            Content="Save As Profile"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="DeletePermissionProfileButton"
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.DeleteSelectedProfileCommand}"
                            Content="Delete Custom"
                            IsEnabled="{x:Bind ViewModel.CanDeleteSelectedProfile, Mode=OneWay}" />
                    </Grid>

                    <!--  Granular Capability Category Checkboxes (2-Column Grid)  -->
                    <Border
                        Padding="10"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Granular AI Capability Permissions (unchecked categories are strictly blocked in all modes):" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <ItemsControl x:Name="PermissionCategoryLeftList" ItemsSource="{x:Bind ViewModel.LeftCapabilities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:McpCapabilityToggleRow">
                                            <CheckBox
                                                Margin="0,2"
                                                IsChecked="{x:Bind IsEnabled, Mode=TwoWay}">
                                                <StackPanel Spacing="1">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Description}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl
                                    x:Name="PermissionCategoryRightList"
                                    Grid.Column="1"
                                    ItemsSource="{x:Bind ViewModel.RightCapabilities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:McpCapabilityToggleRow">
                                            <CheckBox
                                                Margin="0,2"
                                                IsChecked="{x:Bind IsEnabled, Mode=TwoWay}">
                                                <StackPanel Spacing="1">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Description}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Config File & CLI Equivalent Footer  -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Config file:" />
                            <TextBlock
                                x:Name="PermissionsFilePathText"
                                FontFamily="Consolas, monospace"
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.PermissionsFilePathText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="CLI:" />
                            <TextBlock
                                x:Name="CliQuickCommandText"
                                FontFamily="Consolas, monospace"
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.CliQuickCommandText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Side-by-Side Live Dashboard: Restore Points (Left) + MCP Activity Log (Right)  -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <!--  Card 3: Restore Points & Rollback  -->
                <Border
                    x:Name="RestorePointsCard"
                    Grid.Column="0"
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="1">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Restore Points &amp; Rollback" />
                                <TextBlock
                                    x:Name="RestorePointsSummaryText"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.RestorePointsSummaryText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Button
                                    x:Name="RestoreSelectedPointButton"
                                    Command="{x:Bind ViewModel.RestorePointByIdCommand}"
                                    Content="Restore"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Name="DeleteSelectedPointButton"
                                    Command="{x:Bind ViewModel.DeletePointByIdCommand}"
                                    Content="Delete" />
                            </StackPanel>
                        </Grid>

                        <!--  Quick Manual Checkpoint Bar  -->
                        <Border
                            Padding="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox
                                        x:Name="NewCheckpointLabelBox"
                                        PlaceholderText="New checkpoint label..."
                                        Text="{x:Bind ViewModel.NewCheckpointLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        x:Name="CreateCheckpointButton"
                                        Grid.Column="1"
                                        Command="{x:Bind ViewModel.CreateCheckpointCommand}"
                                        Content="Create Checkpoint" />
                                </Grid>
                                <TextBox
                                    x:Name="NewCheckpointPathsBox"
                                    PlaceholderText="File or folder path(s), comma-separated..."
                                    Text="{x:Bind ViewModel.NewCheckpointPaths, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox
                                        x:Name="IncludeSettingsCheck"
                                        Content="settings.json"
                                        IsChecked="{x:Bind ViewModel.IncludeSettingsInCheckpoint, Mode=TwoWay}" />
                                    <CheckBox
                                        x:Name="IncludeAppConfigCheck"
                                        Content="AppConfig.json"
                                        IsChecked="{x:Bind ViewModel.IncludeAppConfigInCheckpoint, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Restore Points List  -->
                        <ListView
                            x:Name="RestorePointsList"
                            Height="300"
                            ItemsSource="{x:Bind ViewModel.RestorePoints}"
                            SelectedItem="{x:Bind ViewModel.SelectedRestorePoint, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:McpRestorePointRow">
                                    <Grid Padding="4,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Border
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Text="{x:Bind KindBadge}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Label}"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    FontFamily="Consolas, monospace"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind TriggerText}" />
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{x:Bind RestoredBadge}" />
                                            </StackPanel>
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind DetailsText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Top"
                                            FontFamily="Consolas, monospace"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind TimestampText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!--  Card 4: MCP Activity Log  -->
                <Border
                    x:Name="ActivityLogCard"
                    Grid.Column="1"
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="1">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="MCP Activity Log" />
                                <TextBlock
                                    x:Name="ActivityLogSummaryText"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.LogSummaryText, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                x:Name="ClearMcpLogButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.ClearActivityLogCommand}"
                                Content="Clear Log" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox
                                x:Name="LogFilterBox"
                                PlaceholderText="Filter tool, args, or restore point..."
                                Text="{x:Bind ViewModel.LogFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox
                                x:Name="LogErrorsOnlyCheck"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="Errors only"
                                IsChecked="{x:Bind ViewModel.LogErrorsOnly, Mode=TwoWay}" />
                        </Grid>

                        <ListView
                            x:Name="McpActivityList"
                            Height="375"
                            ItemsSource="{x:Bind ViewModel.ActivityEntries}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:McpActivityRow">
                                    <Grid Padding="4,5" ColumnDefinitions="56,34,*,Auto" ColumnSpacing="6">
                                        <TextBlock
                                            VerticalAlignment="Top"
                                            FontFamily="Consolas, monospace"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind TimestampText}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            FontFamily="Consolas, monospace"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Text="{x:Bind StatusBadge}" />
                                        <StackPanel Grid.Column="2" Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    FontFamily="Consolas, monospace"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind ToolName}" />
                                                <TextBlock
                                                    FontFamily="Consolas, monospace"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Text="{x:Bind RestorePointBadge}" />
                                            </StackPanel>
                                            <TextBlock
                                                FontFamily="Consolas, monospace"
                                                FontSize="10"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind SummaryText}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Top"
                                            FontFamily="Consolas, monospace"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind DurationText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            FontFamily="Consolas, monospace"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.LogFileText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
